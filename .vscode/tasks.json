{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Rust: テスト",
            "type": "process",
            "command": "python3",
            "args": ["scripts/firmware.py", "test"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Rust: ESP32-S3 ビルド",
            "type": "process",
            "command": "python3",
            "args": ["scripts/firmware.py", "build"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Rust: ESP32-S3 型チェック",
            "type": "process",
            "command": "python3",
            "args": ["scripts/firmware.py", "check"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
